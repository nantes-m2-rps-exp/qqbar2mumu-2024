    "import math\n",
    "residus = []\n",
    "for i in range(len(y_data)):\n",
    "    residus.append(y_data[i]-y_fit[i])\n",
    "print(len(residus))\n",
    "plt.plot(x_data,residus)\n",
    "plt.show()\n",

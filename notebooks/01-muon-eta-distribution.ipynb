   "outputs": [],
   "source": [
    "pTs = np.array([],dtype=float)\n",
    "pTs_mu = np.array([],dtype=float)\n",
    "pTs_antimu = np.array([],dtype=float)\n",
    "nbofTracks=0 # il est toujours utile de compter ...\n",
    "nbofEvents=0 # un événement peut contenir plusieurs traces\n",
    "for event in m[m.nMuons>0]:\n",
    "    nbofEvents+=1\n",
    "    trace = event[\"Muon\"].to_list()\n",
    "    for t in trace:\n",
    "        nbofTracks+=1\n",
    "        pTs = np.append(pTs,pT(t[\"Px\"],t[\"Py\"]))\n",
    "        if t['Charge'] == 1 :\n",
    "            pTs_antimu = np.append(pTs_antimu,pT(t[\"Px\"],t[\"Py\"]))\n",
    "        elif t['Charge'] == -1 :\n",
    "            pTs_mu = np.append(pTs_mu,pT(t[\"Px\"],t[\"Py\"]))\n",
    "\n",
    "           "
   ]
